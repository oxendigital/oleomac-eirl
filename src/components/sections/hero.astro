---
import { Image } from "astro:assets";
import { businessInfo } from "../../config/business-info";
import heroCargo from "../../assets/hero-cargo.png";
import { translations } from "../../config/translations";

const locale = (Astro.currentLocale === "en" ? "en" : "es") as "es" | "en";
const t = translations[locale].hero;
---

<!-- Hero Section -->
<section id="home" class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 bg-muted transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
      <!-- Hero Right Column -->
      <div class="lg:col-span-7 space-y-5 lg:pl-6 reveal-scale">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold leading-[1] tracking-tight text-foreground uppercase">
          {t.titlePart1}<br />
          <span class="text-primary font-light">{t.titleOutline}</span>
        </h1>
        <p class="text-base text-muted-foreground max-w-xl leading-relaxed">
          {t.desc}
        </p>
      </div>

      <!-- Hero Left Column -->
      <div class="lg:col-span-5 space-y-6 reveal-right">
        <div class="space-y-3">
          <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground block">{t.trustedMovement}</span>
          <p class="text-sm font-medium text-muted-foreground max-w-sm leading-relaxed">
            {t.tagline}
          </p>
        </div>
        <a href="#contact" class="inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded bg-foreground text-background font-semibold hover:bg-foreground/90 transition-all duration-200 shadow-md group">
          <span class="text-sm">{t.getStarted}</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>

    <!-- Large Hero Image with Center Logo Overlay -->
    <div class="relative w-full rounded-[24px] overflow-hidden shadow-2xl border border-border/50 group reveal-scale delay-150">
      <Image
        src={heroCargo}
        alt="Port Container Terminal Logistics"
        class="w-full h-[360px] md:h-[540px] object-cover transition-transform duration-700 group-hover:scale-103"
        loading="eager"
      />
      <!-- Centered Logo Overlay Badge -->
      <div class="absolute inset-0 flex items-center justify-center bg-black/10">
        <div class="h-20 w-20 md:h-28 md:w-28 rounded-full bg-background/95 shadow-2xl backdrop-blur-sm border border-border/20 flex items-center justify-center text-foreground transition-transform duration-500 hover:scale-110">

        </div>
      </div>
    </div>
  </div>
</section>
