---
import { translations } from "../../config/translations";

const locale = (Astro.currentLocale === "en" ? "en" : "es") as "es" | "en";
const t = translations[locale].hero;
---

<!-- Hero Section -->
<section id="home" class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 bg-muted transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Hero Left Column: Text and CTA -->
      <div class="lg:col-span-7 space-y-6 lg:pl-6 reveal-scale">
        <div class="space-y-2">
          <span class="font-mono text-xs uppercase tracking-widest text-primary font-semibold block">{t.trustedMovement}</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold leading-[1.1] tracking-tight text-foreground uppercase">
            {t.titlePart1} {t.titlePart2}<br />
            <span class="text-primary font-light">{t.titleOutline}</span>
          </h1>
        </div>
        
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl leading-relaxed">
          {t.desc}
        </p>

        <div class="border-l-2 border-primary/30 pl-4 py-1">
          <p class="text-sm italic text-muted-foreground">
            {t.tagline}
          </p>
        </div>

        <div class="pt-2">
          <a href="#contact" class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded bg-foreground text-background font-semibold hover:bg-foreground/90 transition-all duration-200 shadow-md group cursor-pointer">
            <span class="text-sm">{t.getStarted}</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Hero Right Column: Video Showcase -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center space-y-4 reveal-right">
        <!-- Main Video Card -->
        <div class="relative w-full max-w-[300px] sm:max-w-[320px] aspect-[9/16] rounded-[24px] overflow-hidden shadow-2xl border border-border/50 bg-black group">
          <video
            id="hero-video-player"
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover transition-opacity duration-300"
          >
            <source id="hero-video-source" src="/assets-oleomac/video1.mp4" type="video/mp4" />
          </video>
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-65 pointer-events-none"></div>
          
          <!-- Badge overlay -->
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between pointer-events-none">
            <div class="bg-black/55 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10 flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
              <span id="hero-video-label" class="text-[10px] font-mono text-white/90 uppercase tracking-wider">Pruebas Hidráulicas</span>
            </div>
          </div>
        </div>

        <!-- Video Selection Thumbnails -->
        <div class="flex items-center justify-center gap-2 pt-2">
          <button class="video-selector-btn active px-3 py-1 rounded bg-foreground text-background text-[11px] font-mono border border-border transition-all cursor-pointer" data-video-src="/assets-oleomac/video1.mp4" data-video-label="Pruebas Hidráulicas">1</button>
          <button class="video-selector-btn px-3 py-1 rounded bg-muted hover:bg-muted/80 text-muted-foreground text-[11px] font-mono border border-border transition-all cursor-pointer" data-video-src="/assets-oleomac/video2.mp4" data-video-label="Servicio de Flushing">2</button>
          <button class="video-selector-btn px-3 py-1 rounded bg-muted hover:bg-muted/80 text-muted-foreground text-[11px] font-mono border border-border transition-all cursor-pointer" data-video-src="/assets-oleomac/video3.mp4" data-video-label="Montaje de Líneas">3</button>
          <button class="video-selector-btn px-3 py-1 rounded bg-muted hover:bg-muted/80 text-muted-foreground text-[11px] font-mono border border-border transition-all cursor-pointer" data-video-src="/assets-oleomac/video4.mp4" data-video-label="Mantenimiento Taller">4</button>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const player = document.getElementById('hero-video-player') as HTMLVideoElement | null;
  const label = document.getElementById('hero-video-label') as HTMLElement | null;
  const buttons = document.querySelectorAll('.video-selector-btn') as NodeListOf<HTMLButtonElement>;

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (!player) return;
      
      const newSrc = btn.getAttribute('data-video-src');
      const newLabel = btn.getAttribute('data-video-label');
      
      if (newSrc) {
        player.style.opacity = '0';
        setTimeout(() => {
          player.src = newSrc;
          player.load();
          player.play();
          player.style.opacity = '1';
        }, 150);
      }
      
      if (label && newLabel) {
        label.textContent = newLabel;
      }
      
      // Update active state
      buttons.forEach(b => {
        b.classList.remove('active', 'bg-foreground', 'text-background');
        b.classList.add('bg-muted', 'text-muted-foreground');
      });
      btn.classList.remove('bg-muted', 'text-muted-foreground');
      btn.classList.add('active', 'bg-foreground', 'text-background');
    });
  });
</script>
