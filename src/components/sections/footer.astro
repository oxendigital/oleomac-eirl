---
import { businessInfo } from "../../config/business-info";
import { siteConfig } from "../../config/site-config";
import { translations } from "../../config/translations";

const locale = (Astro.currentLocale === "en" ? "en" : "es") as "es" | "en";
const t = translations[locale].footer;
const tNav = translations[locale].nav;

const currentYear = new Date().getFullYear();
---

<footer class="bg-zinc-950 text-zinc-400 pt-14 pb-8 border-t border-zinc-900 transition-colors duration-300 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Main Grid: 3 columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-10 border-b border-zinc-900">

      <!-- Column 1: Brand -->
      <div class="space-y-5">
        <a href="#home" class="flex items-center gap-2.5">
          <div class="h-8 w-8 rounded bg-white flex items-center justify-center text-zinc-950 font-bold text-sm font-heading">
            {businessInfo.brand.name.charAt(0)}
          </div>
          <span class="font-heading text-xl tracking-tight text-white font-bold">
            {businessInfo.brand.name}
          </span>
        </a>
        <p class="text-zinc-500 leading-relaxed text-sm max-w-xs">
          {businessInfo.brand.shortDescription}
        </p>
        <!-- Social Links -->
        <div class="flex items-center gap-2">
          {businessInfo.socials?.linkedin && (
            <a href={businessInfo.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="h-8 w-8 rounded border border-zinc-800 flex items-center justify-center text-zinc-400 hover:bg-white hover:text-zinc-950 hover:border-white transition-all duration-200">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          )}
          {businessInfo.socials?.instagram && (
            <a href={businessInfo.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="h-8 w-8 rounded border border-zinc-800 flex items-center justify-center text-zinc-400 hover:bg-white hover:text-zinc-950 hover:border-white transition-all duration-200">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          )}
          {businessInfo.socials?.facebook && (
            <a href={businessInfo.socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="h-8 w-8 rounded border border-zinc-800 flex items-center justify-center text-zinc-400 hover:bg-white hover:text-zinc-950 hover:border-white transition-all duration-200">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.8c4.56-.93 8-4.96 8-9.8z"/>
              </svg>
            </a>
          )}
        </div>
        <!-- Online status -->
        <div class="inline-flex items-center gap-2 text-xs text-zinc-500 font-mono select-none">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
          </span>
          {t.networkStatus}
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="space-y-4">
        <span class="text-zinc-500 text-xs uppercase tracking-widest font-semibold block">{t.quickLinks}</span>
        <ul class="space-y-2.5">
          <li><a href="#home" class="hover:text-white transition-colors duration-200">{tNav.home}</a></li>
          <li><a href="#about" class="hover:text-white transition-colors duration-200">{tNav.product}</a></li>
          <li><a href="#services" class="hover:text-white transition-colors duration-200">{tNav.production}</a></li>
          <li><a href="#team" class="hover:text-white transition-colors duration-200">{tNav.team}</a></li>
          <li><a href="#contact" class="hover:text-white transition-colors duration-200">{tNav.contact}</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact -->
      <div class="space-y-4">
        <span class="text-zinc-500 text-xs uppercase tracking-widest font-semibold block">{translations[locale].contact.mainOffice}</span>
        <p class="text-zinc-400 leading-relaxed">
          {businessInfo.location.address}<br />
          {businessInfo.location.city}, {businessInfo.location.region}
        </p>
        <div class="space-y-2 pt-2 border-t border-zinc-900">
          <div class="flex justify-between items-center text-xs">
            <span class="text-zinc-500">{translations[locale].contact.callSupport}</span>
            <a href={`tel:${businessInfo.contact.phone}`} class="text-white hover:underline font-medium">
              {businessInfo.contact.phone}
            </a>
          </div>
          <div class="flex justify-between items-center text-xs gap-4">
            <span class="text-zinc-500 shrink-0">{translations[locale].contact.emailUs}</span>
            <a href={`mailto:${businessInfo.contact.email}`} class="text-white hover:underline font-medium truncate">
              {businessInfo.contact.email}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row justify-between items-center pt-6 text-zinc-600 gap-4 text-xs">
      <p class="max-w-sm">&copy; {currentYear} {businessInfo.brand.legalName}. {t.copyright} — {t.developedBy} <a href="https://oxen.cl" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-400 underline decoration-zinc-800">Oxen Digital</a>.</p>
      <div class="flex items-center gap-5 uppercase font-semibold tracking-wide">
        <a href="#privacy" class="hover:text-zinc-400 transition-colors">{t.privacy}</a>
        <a href="#terms" class="hover:text-zinc-400 transition-colors">{t.terms}</a>
        <button id="back-to-top" class="hover:text-zinc-400 transition-colors cursor-pointer border-0 bg-transparent text-zinc-600 outline-none">
          {t.backToTop}
        </button>
      </div>
    </div>

  </div>
</footer>

<script>
  const backToTopBtn = document.getElementById('back-to-top');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
