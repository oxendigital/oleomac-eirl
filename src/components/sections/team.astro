---
import { Image } from "astro:assets";
import teamAlexander from "../../assets/team-alexander.png";
import teamDerrick from "../../assets/team-derrick.png";
import teamNathaniel from "../../assets/team-nathaniel.png";
import teamVictor from "../../assets/team-victor.png";
import { translations } from "../../config/translations";
import { businessInfo } from "../../config/business-info";

const locale = (Astro.currentLocale === "en" ? "en" : "es") as "es" | "en";
const t = translations[locale].team;

const showHiring = businessInfo.hiring ?? false;
const hasCustomTeam = businessInfo.team && businessInfo.team.length > 0;

const normalizedTeam = hasCustomTeam
  ? businessInfo.team!.map((member) => ({
      name: member.name,
      img: member.imageUrl || "",
      email: member.email || "",
      linkedin: member.linkedin || "",
      role: member.role,
      isAsset: false
    }))
  : [
      {
        name: "Alexander Moreira Piero",
        img: teamAlexander,
        email: "alexander@iteloogs.co",
        linkedin: "https://linkedin.com",
        role: locale === "es" ? "Fundador y Director Ejecutivo" : "Founder & Chief Executive Officer",
        isAsset: true
      },
      {
        name: "Derrick Lawson Angelosa",
        img: teamDerrick,
        email: "derrick@iteloogs.co",
        linkedin: "https://linkedin.com",
        role: locale === "es" ? "Director de Operaciones" : "Chief Operating Officer",
        isAsset: true
      },
      {
        name: "Nathaniel Brooks Campel",
        img: teamNathaniel,
        email: "nathaniel@iteloogs.co",
        linkedin: "https://linkedin.com",
        role: locale === "es" ? "Director de Finanzas" : "Chief Financial Officer",
        isAsset: true
      },
      {
        name: "Victor Bros A Cocolaso",
        img: teamVictor,
        email: "victor@iteloogs.co",
        linkedin: "https://linkedin.com",
        role: locale === "es" ? "Director de Marketing" : "Chief Marketing Officer",
        isAsset: true
      }
    ];
---

<!-- Team Section -->
<section id="team" class="py-20 bg-muted border-t border-border/50 transition-colors duration-300 reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-16">
      <!-- Tag -->
      <div class="lg:col-span-3">
        <span class="font-mono text-sm uppercase tracking-widest text-muted-foreground block">{t.label}</span>
      </div>
      <!-- Title -->
      <div class="lg:col-span-9">
        <h2 class="text-4xl sm:text-5xl font-heading font-extrabold leading-tight tracking-tight text-foreground uppercase">
          {t.titlePart1}<br />
          <span class="text-primary font-light">{t.titlePart2}</span>
        </h2>
      </div>
    </div>

    <!-- Main Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch">

      {showHiring && (
        <!-- Left Side: Join Us Card (intentionally always dark) -->
        <div class="lg:col-span-4 flex flex-col">
          <div class="p-8 sm:p-10 bg-zinc-950 text-white rounded-3xl flex flex-col justify-between h-full min-h-[320px] border border-zinc-800 shadow-xl reveal delay-100 relative overflow-hidden group">
            <div class="absolute -top-20 -right-20 w-40 h-40 bg-white/5 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700"></div>
            <div class="space-y-6 relative z-10 font-semibold">
              <h3 class="text-3xl font-bold leading-tight tracking-tight uppercase font-heading text-white">
                {t.joinTitle}
              </h3>
              <p class="text-sm text-zinc-400 leading-relaxed max-w-xs">
                {t.joinDesc}
              </p>
            </div>
            <div class="relative z-10 pt-8">
              <a href="#contact" class="inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded bg-white text-zinc-950 hover:bg-zinc-100 transition-all duration-200 text-sm font-bold shadow-md">
                <span>{t.openPositions}</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      )}

      <!-- Team Grid -->
      <div class={showHiring ? "lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-8" : "lg:col-span-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8"}>
        {normalizedTeam.map((exec, idx) => (
          <div class={`bg-card border border-border/50 rounded-3xl overflow-hidden flex flex-col justify-between shadow-sm p-5 reveal delay-${150 + idx * 50} group hover:shadow-md transition-all duration-300`}>
            <div class="rounded-2xl overflow-hidden aspect-square mb-6 bg-muted border border-border relative flex items-center justify-center">
              {exec.isAsset ? (
                <Image
                  src={exec.img as any}
                  alt={exec.name}
                  class="w-full h-full object-cover transition-all duration-700 filter grayscale group-hover:grayscale-0 group-hover:scale-103"
                />
              ) : exec.img ? (
                <img
                  src={exec.img as string}
                  alt={exec.name}
                  class="w-full h-full object-cover transition-all duration-700 filter grayscale group-hover:grayscale-0 group-hover:scale-103"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-muted text-muted-foreground font-bold font-mono text-2xl uppercase select-none">
                  {exec.name.split(' ').map(n => n[0]).join('').slice(0, 2)}
                </div>
              )}
              <!-- Social Overlay -->
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-4 z-10">
                {exec.linkedin && (
                  <a href={exec.linkedin} target="_blank" rel="noopener noreferrer" class="h-10 w-10 rounded-full bg-background/90 text-foreground flex items-center justify-center hover:bg-background hover:scale-110 transition-all shadow-md">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                )}
                {exec.email && (
                  <a href={`mailto:${exec.email}`} class="h-10 w-10 rounded-full bg-background/90 text-foreground flex items-center justify-center hover:bg-background hover:scale-110 transition-all shadow-md">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
            <div class="space-y-2">
              <h4 class="font-heading text-base font-semibold text-foreground leading-tight group-hover:text-foreground/80 transition-colors">{exec.name}</h4>
              <p class="text-xs uppercase tracking-widest text-muted-foreground font-bold leading-none">{exec.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
