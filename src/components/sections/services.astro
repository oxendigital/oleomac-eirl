---
import { translations } from "../../config/translations";

const locale = (Astro.currentLocale === "en" ? "en" : "es") as "es" | "en";
const t = translations[locale].services;
---

<!-- Services Section -->
<section id="services" class="py-20 bg-background transition-colors duration-300 reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start mb-16">
      <!-- Tag -->
      <div class="lg:col-span-3">
        <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground block">{t.label}</span>
      </div>
      <!-- Title -->
      <div class="lg:col-span-9">
        <h2 class="text-4xl sm:text-5xl font-heading font-extrabold leading-tight tracking-tight text-foreground uppercase">
          {t.titlePart1}<br />
          <span class="text-primary font-light">{t.titlePart2}</span>
        </h2>
      </div>
    </div>

    <!-- Services main grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-stretch">
      <!-- Left Image Panel -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl overflow-hidden h-full min-h-150 relative border border-border/50 bg-muted group shadow-md">
          <img
            src="/assets-oleomac/img7.avif"
            alt="Análisis y reparación de componentes oleohidráulicos"
            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 opacity-100 service-image-panel"
            data-image-index="0"
            loading="lazy"
          />
          <img
            src="/assets-oleomac/img8.avif"
            alt="Montajes oleohidráulicos industriales"
            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 opacity-0 service-image-panel"
            data-image-index="1"
            loading="lazy"
          />
          <img
            src="/assets-oleomac/img9.avif"
            alt="Construcción y diseño de centrales hidráulicas"
            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 opacity-0 service-image-panel"
            data-image-index="2"
            loading="lazy"
          />
          <img
            src="/assets-oleomac/img10.avif"
            alt="Importación de componentes y repuestos oleohidráulicos"
            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 opacity-0 service-image-panel"
            data-image-index="3"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/10 dark:bg-black/20 z-10 pointer-events-none"></div>
        </div>
      </div>

      <!-- Right Accordion List -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <div class="space-y-4 animate-reveal-items lg:min-h-[500px]">
          {t.servicesList.map((service, idx) => {
            const isFirst = idx === 0;
            return (
              <div
                data-service-item
                data-service-index={idx}
                class={isFirst
                  ? "p-6 rounded-2xl bg-foreground border border-foreground flex flex-col justify-start shadow-lg transition-all duration-300 group cursor-pointer"
                  : "p-6 rounded-2xl bg-muted border border-border flex flex-col justify-start transition-all duration-300 hover:border-border group cursor-pointer"
                }
              >
                <div class="flex items-center justify-between w-full">
                  <div class="flex items-center gap-4">
                    <span class="service-num font-mono text-xs text-muted-foreground">(0{idx + 1})</span>
                    <span class={isFirst ? "service-title text-base font-bold text-background" : "service-title text-base font-bold text-foreground"}>{service.title}</span>
                  </div>
                  <div class={isFirst
                    ? "service-arrow h-8 w-8 rounded-full bg-background flex items-center justify-center text-foreground transition-all rotate-90"
                    : "service-arrow h-8 w-8 rounded-full border border-border flex items-center justify-center text-muted-foreground group-hover:text-foreground group-hover:border-foreground transition-all"
                  }>
                    <svg class="w-4 h-4 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={isFirst ? "2.5" : "2"}>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>

                <!-- Collapsible Details -->
                <div class={isFirst
                  ? "service-collapse grid grid-rows-[1fr] opacity-100 transition-[grid-template-rows,opacity] duration-300 ease-in-out"
                  : "service-collapse grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out"
                }>
                  <div class="overflow-hidden">
                    <p class={isFirst
                      ? "service-desc text-sm leading-relaxed text-background/80 mt-4 animate-fadeIn"
                      : "service-desc text-sm leading-relaxed text-muted-foreground mt-0"
                    }>
                      {service.desc}
                    </p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- View More button -->
        <div class="pt-4 self-start">
          <a href="#contact" class="inline-flex items-center justify-center gap-3 px-8 py-3 rounded bg-foreground text-background font-semibold hover:bg-foreground/90 transition-all duration-200 shadow-md group">
            <span class="text-sm">{t.viewMore}</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // --- Services Interactive Tab Switcher ---
  const serviceItems = document.querySelectorAll('[data-service-item]');
  const serviceImages = document.querySelectorAll('.service-image-panel');

  function activateService(index: number) {
    serviceItems.forEach((item, idx) => {
      const isCurrent = idx === index;
      const numSpan = item.querySelector('.service-num');
      const titleSpan = item.querySelector('.service-title');
      const arrowCircle = item.querySelector('.service-arrow');
      const arrowSvg = item.querySelector('.service-arrow svg');
      const collapseDiv = item.querySelector('.service-collapse');
      const descPara = item.querySelector('.service-desc');

      if (isCurrent) {
        item.className = "p-6 rounded-2xl bg-foreground border border-foreground flex flex-col justify-start shadow-lg transition-all duration-300 group cursor-pointer";
        if (numSpan) numSpan.className = "service-num font-mono text-xs text-muted-foreground";
        if (titleSpan) titleSpan.className = "service-title text-base font-bold text-background";
        if (arrowCircle) arrowCircle.className = "service-arrow h-8 w-8 rounded-full bg-background flex items-center justify-center text-foreground transition-all rotate-90";
        if (arrowSvg) arrowSvg.setAttribute('stroke-width', '2.5');
        if (collapseDiv) {
          collapseDiv.className = "service-collapse grid grid-rows-[1fr] opacity-100 transition-[grid-template-rows,opacity] duration-300 ease-in-out";
        }
        if (descPara) {
          descPara.className = "service-desc text-sm leading-relaxed text-background/80 mt-4";
        }
      } else {
        item.className = "p-6 rounded-2xl bg-muted border border-border flex flex-col justify-start transition-all duration-300 hover:border-border group cursor-pointer";
        if (numSpan) numSpan.className = "service-num font-mono text-xs text-muted-foreground";
        if (titleSpan) titleSpan.className = "service-title text-base font-bold text-foreground";
        if (arrowCircle) arrowCircle.className = "service-arrow h-8 w-8 rounded-full border border-border flex items-center justify-center text-muted-foreground group-hover:text-foreground group-hover:border-foreground transition-all";
        if (arrowSvg) arrowSvg.setAttribute('stroke-width', '2');
        if (collapseDiv) {
          collapseDiv.className = "service-collapse grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out";
        }
        if (descPara) {
          descPara.className = "service-desc text-sm leading-relaxed text-muted-foreground mt-0";
        }
      }
    });

    serviceImages.forEach((img) => {
      const imgIdx = parseInt(img.getAttribute('data-image-index') || '0', 10);
      const targetIndex = index % serviceImages.length;
      if (imgIdx === targetIndex) {
        img.classList.remove('opacity-0');
        img.classList.add('opacity-100');
      } else {
        img.classList.remove('opacity-100');
        img.classList.add('opacity-0');
      }
    });
  }

  serviceItems.forEach((item, idx) => {
    item.addEventListener('click', () => activateService(idx));
    item.addEventListener('mouseenter', () => activateService(idx));
  });

  activateService(0);
</script>
