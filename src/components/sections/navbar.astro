---
import { businessInfo } from "../../config/business-info";
import { translations } from "../../config/translations";
import { siteConfig } from "../../config/site-config";

const locale = (Astro.currentLocale === "en" ? "en" : "es") as "es" | "en";
const tNav = translations[locale].nav;

const defaultLocale = siteConfig.i18n.defaultLocale;
const currentLocale = Astro.currentLocale ?? defaultLocale;

// Data-driven: any new locale added to site-config automatically appears here
const localeOptions = siteConfig.i18n.locales.map(loc => ({
  loc,
  label: loc.split('-')[0].toUpperCase(),
  href: loc === defaultLocale ? '/' : `/${loc}`,
  isCurrent: loc === currentLocale,
}));

const currentLabel = localeOptions.find(o => o.isCurrent)?.label
  ?? localeOptions[0].label;
const showLangSelector = localeOptions.length > 1;
---

<header class="sticky top-0 z-50 w-full bg-background/95 backdrop-blur-md border-b border-border transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href={locale === "es" ? "#home" : "/en#home"} class="flex items-center gap-2.5 shrink-0">
      <div class="h-8 w-8 rounded bg-foreground flex items-center justify-center text-background font-bold text-sm font-heading">
        {businessInfo.brand.name.charAt(0)}
      </div>
      <span class="font-heading text-xl tracking-tight text-foreground font-bold">
        {businessInfo.brand.name}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      <nav class="flex items-center gap-6 text-sm font-medium text-muted-foreground">
        <a href="#home" class="hover:text-foreground transition-colors duration-200">{tNav.home}</a>
        <a href="#about" class="hover:text-foreground transition-colors duration-200">{tNav.product}</a>
        <a href="#services" class="hover:text-foreground transition-colors duration-200">{tNav.production}</a>
        <a href="#team" class="hover:text-foreground transition-colors duration-200">{tNav.team}</a>
      </nav>

      <div class="h-5 w-[1px] bg-border"></div>

      <div class="flex items-center gap-1">
        <!-- Theme Toggle -->
        <button id="theme-toggle" class="p-2 rounded hover:bg-muted text-muted-foreground hover:text-foreground transition-all cursor-pointer outline-none border-0 bg-transparent flex items-center justify-center" aria-label="Toggle theme">
          <svg class="h-4 w-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
          <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        <!-- Language Selector (only rendered when >1 locale) -->
        {showLangSelector && (
          <div class="relative" id="lang-selector">
            <button
              id="lang-btn"
              class="flex items-center gap-1 px-2 py-2 rounded text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-all cursor-pointer outline-none border-0 bg-transparent"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-label="Select language"
            >
              <span class="font-mono text-xs tracking-wider">{currentLabel}</span>
              <svg class="w-3 h-3 transition-transform duration-200" id="lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              id="lang-dropdown"
              class="hidden absolute right-0 top-full mt-1 bg-background border border-border rounded shadow-lg overflow-hidden min-w-[64px] z-50"
              role="listbox"
            >
              {localeOptions.map(opt => (
                <a
                  href={opt.href}
                  role="option"
                  aria-selected={opt.isCurrent}
                  class={`flex items-center justify-between gap-2 px-3 py-2 text-xs font-mono tracking-wider transition-colors duration-150 ${
                    opt.isCurrent
                      ? 'text-foreground font-bold bg-muted cursor-default'
                      : 'text-muted-foreground hover:text-foreground hover:bg-muted'
                  }`}
                >
                  {opt.label}
                  {opt.isCurrent && (
                    <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="h-5 w-[1px] bg-border mx-1"></div>

        <a href="#contact" class="inline-flex items-center justify-center px-5 py-2 rounded bg-foreground text-background hover:bg-foreground/90 transition-all duration-200 text-sm font-semibold">
          {tNav.contact}
        </a>
      </div>
    </div>

    <!-- Mobile Controls -->
    <div class="md:hidden flex items-center gap-1">
      <button id="theme-toggle-mobile" class="p-2 rounded hover:bg-muted text-muted-foreground transition-all cursor-pointer outline-none border-0 bg-transparent flex items-center justify-center" aria-label="Toggle theme">
        <svg class="h-4.5 w-4.5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="h-4.5 w-4.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <button id="mobile-menu-btn" class="p-2 rounded hover:bg-muted text-muted-foreground focus:outline-none select-none border-0 bg-transparent flex items-center justify-center cursor-pointer" aria-label="Toggle mobile menu">
        <svg id="hamburger-icon" class="h-5 w-5 transition-all duration-300 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="h-5 w-5 transition-all duration-300 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="fixed inset-x-0 top-16 bg-background/95 backdrop-blur-lg border-b border-border px-6 py-6 shadow-lg hidden flex-col space-y-1 z-40 transition-all duration-300 opacity-0 transform -translate-y-2">
    <a href="#home" class="mobile-nav-link block py-3 px-3 rounded text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">{tNav.home}</a>
    <a href="#about" class="mobile-nav-link block py-3 px-3 rounded text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">{tNav.product}</a>
    <a href="#services" class="mobile-nav-link block py-3 px-3 rounded text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">{tNav.production}</a>
    <a href="#team" class="mobile-nav-link block py-3 px-3 rounded text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">{tNav.team}</a>
    <div class="pt-3 pb-1">
      <a href="#contact" class="mobile-nav-link block py-3 rounded bg-foreground text-background font-semibold text-sm text-center transition-all">
        {tNav.contact}
      </a>
    </div>

    <!-- Language Switcher in mobile menu -->
    {showLangSelector && (
      <div class="pt-3 border-t border-border">
        <p class="px-3 pb-2 text-xs font-mono uppercase tracking-widest text-muted-foreground/60">
          {locale === "es" ? "Idioma" : "Language"}
        </p>
        <div class="flex gap-1">
          {localeOptions.map(opt => (
            <a
              href={opt.href}
              class={`flex-1 text-center py-2 rounded text-xs font-mono tracking-wider font-semibold transition-colors ${
                opt.isCurrent
                  ? 'bg-foreground text-background cursor-default'
                  : 'text-muted-foreground hover:text-foreground hover:bg-muted'
              }`}
            >
              {opt.label}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</header>

<script>
  // --- Dark Mode ---
  const themeToggle = document.getElementById('theme-toggle');
  const themeToggleMobile = document.getElementById('theme-toggle-mobile');

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  if (themeToggle) themeToggle.addEventListener('click', toggleTheme);
  if (themeToggleMobile) themeToggleMobile.addEventListener('click', toggleTheme);

  // --- Language Dropdown ---
  const langBtn = document.getElementById('lang-btn');
  const langDropdown = document.getElementById('lang-dropdown');
  const langChevron = document.getElementById('lang-chevron');
  let langOpen = false;

  function openLang() {
    langOpen = true;
    langDropdown?.classList.remove('hidden');
    langBtn?.setAttribute('aria-expanded', 'true');
    langChevron?.classList.add('rotate-180');
  }

  function closeLang() {
    langOpen = false;
    langDropdown?.classList.add('hidden');
    langBtn?.setAttribute('aria-expanded', 'false');
    langChevron?.classList.remove('rotate-180');
  }

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langOpen ? closeLang() : openLang();
  });

  // Close on outside click
  document.addEventListener('click', () => { if (langOpen) closeLang(); });
  langDropdown?.addEventListener('click', (e) => e.stopPropagation());

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && langOpen) closeLang();
  });

  // --- Mobile Menu ---
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
  let isMenuOpen = false;

  function toggleMobileMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      mobileMenu?.classList.remove('hidden');
      mobileMenu?.classList.add('flex');
      void mobileMenu?.offsetWidth;
      mobileMenu?.classList.remove('opacity-0', '-translate-y-2');
      mobileMenu?.classList.add('opacity-100', 'translate-y-0');
      hamburgerIcon?.classList.replace('block', 'hidden');
      closeIcon?.classList.replace('hidden', 'block');
    } else {
      mobileMenu?.classList.remove('opacity-100', 'translate-y-0');
      mobileMenu?.classList.add('opacity-0', '-translate-y-2');
      setTimeout(() => {
        if (!isMenuOpen) {
          mobileMenu?.classList.remove('flex');
          mobileMenu?.classList.add('hidden');
        }
      }, 300);
      hamburgerIcon?.classList.replace('hidden', 'block');
      closeIcon?.classList.replace('block', 'hidden');
    }
  }

  mobileMenuBtn?.addEventListener('click', toggleMobileMenu);
  mobileNavLinks.forEach(link => {
    link.addEventListener('click', () => { if (isMenuOpen) toggleMobileMenu(); });
  });
</script>
