---
import { Image } from "astro:assets";
import ctaLoading from "../../assets/cta-loading.png";
import { translations } from "../../config/translations";

const locale = (Astro.currentLocale === "en" ? "en" : "es") as "es" | "en";
const t = translations[locale].cta;
---

<!-- CTA Banner - Full Width -->
<section class="relative overflow-hidden py-24 md:py-32 bg-zinc-950 transition-colors duration-300 reveal group">

  <!-- Background Image -->
  <div class="absolute inset-0">
    <Image
      src={ctaLoading}
      alt="Loading cargo truck background"
      class="w-full h-full object-cover opacity-25 transition-transform duration-[8000ms] group-hover:scale-105 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/75 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl space-y-7 reveal-scale delay-150">
      <span class="font-mono text-xs uppercase tracking-widest text-zinc-400 block">{t.label}</span>
      <h2 class="text-3xl sm:text-5xl font-heading font-extrabold leading-tight tracking-tight text-white uppercase">
        {t.titlePart1}<br />
        <span class="text-primary font-light">{t.titlePart2}</span>
      </h2>
      <p class="text-base text-zinc-300 max-w-lg leading-relaxed">
        {t.desc}
      </p>
      <div class="flex flex-wrap gap-3 items-center">
        <a href="#contact" class="inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded bg-white text-zinc-950 font-semibold hover:bg-zinc-100 shadow-md transition-all duration-200">
          <span class="text-sm">{t.workTogether}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="#services" class="inline-flex items-center justify-center px-8 py-3.5 rounded border border-white/20 hover:border-white/60 hover:bg-white/5 text-white font-medium text-sm transition-all duration-200">
          {t.exploreServices}
        </a>
      </div>
    </div>
  </div>

</section>
